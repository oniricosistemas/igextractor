{
  "name": "igextractor",
  "version": "1.0.63",
  "description": "Instagram data extractor TUI - Free & Pro",
  "main": "src/index.js",
  "bin": {
    "igextractor": "./bin/igextractor.js"
  },
  "scripts": {
    "start": "node bin/igextractor.js",
    "build": "node scripts/build.js",
    "build:win": "pkg bin/igextractor.js --targets node18-win-x64 --output dist/igextractor-win.exe",
    "build:mac": "pkg bin/igextractor.js --targets node18-macos-x64 --output dist/igextractor-macos",
    "build:linux": "pkg bin/igextractor.js --targets node18-linux-x64 --output dist/igextractor-linux"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js",
      "bin/**/*.js"
    ],
    "assets": [
      "node_modules/figlet/fonts/**",
      "node_modules/puppeteer/.local-chromium/**",
      "node_modules/puppeteer-core/.local-chromium/**"
    ],
    "targets": [
      "node20-win-x64",
      "node20-macos-x64",
      "node20-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "figlet": "^1.7.0",
    "inquirer": "^8.2.6",
    "boxen": "^5.1.2",
    "gradient-string": "^2.0.2",
    "cli-table3": "^0.6.3",
    "puppeteer": "^22.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
